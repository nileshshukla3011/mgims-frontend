# Copy to .env and adjust. All VITE_* values are built into the public bundle — never put secrets here.

# true (default): use the bundled scraped data in src/data. false: call the backend API.
VITE_USE_MOCK_API=true

# Backend REST API base URL (used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=http://localhost:5000/api

# Demo only: password that opens the admin console in mock mode. Leave empty in production.
# User ID `superadmin` = super administrator; `<department-id>-admin` (e.g. `medicine-admin`) = that department's admin.
VITE_ADMIN_DEMO_PASSWORD=

# Admin console only: address of the public website, for links from the console.
# Empty: http://localhost:5173 when running `npm run dev:admin`, https://www.mgims.ac.in in a build.
VITE_PUBLIC_SITE_URL=

# true: show hand-written content awaiting MGIMS confirmation, with a review banner (docs/CONTENT_REVIEW.md).
# Leave empty for the live site, where that content stays hidden.
VITE_SHOW_REVIEW_NOTES=

# Admin console: minutes without activity before it signs out (default 15).
VITE_ADMIN_IDLE_MINUTES=

# Portals (built by other teams). An address here sends /patient-portal, /student-portal or /fee-portal to that portal,
# keeping any sub-path. Empty: the website shows a "coming soon" page for that portal (src/config/portals.ts).
VITE_PATIENT_PORTAL_URL=
VITE_STUDENT_PORTAL_URL=
VITE_FEE_PORTAL_URL=

# Where photos and documents are served from once copied off the old site (scripts/download-media.mjs).
# Empty: images keep their original addresses.
VITE_MEDIA_BASE_URL=

# Error monitoring: an address that receives errors and page-speed figures as JSON (any service). Empty: not sent.
VITE_MONITORING_URL=
# Release name sent with each error report, e.g. the git commit.
VITE_RELEASE=

# Production origin, read at build time: sitemap.xml and robots.txt (scripts/generate-sitemap.mjs), canonical links,
# the link-preview image and the organisation's structured data (vite.config.ts).
SITE_URL=https://www.mgims.ac.in
