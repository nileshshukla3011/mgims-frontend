{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/admin",
              "@/admin/*",
              "**/admin/**"
            ],
            "message": "The public website must not import admin console code (it would ship in the public bundle). Move shared code to src/components, src/services or src/utils."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/admin/**",
        "admin/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
